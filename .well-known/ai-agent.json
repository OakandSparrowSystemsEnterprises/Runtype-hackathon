{
  "name": "Gatekeeper V2",
  "operator": "Oak & Sparrow Systems Enterprise",
  "description": "Deterministic pre-execution authority for autonomous and multi-agent systems.",
  "environment": "hackathon-staging",
  "principle": "Content can provide evidence. Content cannot grant authority.",
  "service": {
    "base_url": "https://demonstrated-board-billy-portable.trycloudflare.com",
    "health": "https://demonstrated-board-billy-portable.trycloudflare.com/health"
  },
  "capabilities": {
    "health_check": {
      "available": true,
      "method": "GET",
      "path": "/health"
    },
    "artifact_ingress": {
      "available": true,
      "method": "POST",
      "path": "/api/v2/artifacts",
      "authentication": "hmac-sha256",
      "identity_binding": "sha256"
    },
    "governed_effects": {
      "available": true,
      "method": "POST",
      "path": "/api/v2/actions/navigation",
      "authentication": "hmac-sha256",
      "required_capability": "parent-shield.navigation"
    }
  },
  "authority_model": {
    "content_grants_authority": false,
    "delegation_may_exceed_scope": false,
    "pre_execution_enforcement": true
  }
}